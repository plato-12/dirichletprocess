profile_complex <- function(n_obs = 300, n_iter = 100) {
  set.seed(456)
  y <- c(rnorm(n_obs/2, -2, 0.5), rnorm(n_obs/2, 2, 0.5))

  profvis({
    dp <- DirichletProcessGaussian(y)
    dp <- Fit(dp, n_iter)
  })
}

# Multivariate normal profiling
profile_mvn <- function(n_obs = 200, n_iter = 50) {

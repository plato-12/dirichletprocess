  mu2 <- colMeans(y[11:20, ])
  sig1 <- cov(y[1:10, ])
  sig2 <- cov(y[11:20, ])

  dp$clusterParameters <- list(
    mu = array(c(mu1, mu2), dim = c(1, 2, 2)),
    sig = array(c(sig1, sig2), dim = c(2, 2, 2))
  )

  # Convert to 0-indexed for C++
  dp_cpp <- dp
  dp_cpp$clusterLabels <- dp$clusterLabels - 1

  # Run C++ update

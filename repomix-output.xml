    <pre class="usage"><span class='fu'>DirichletProcessHierarchicalBeta</span>(<span class='kw'>dataList</span>, <span class='kw'>maxY</span>, priorParameters = <span class='fu'><a href='https://rdrr.io/r/base/c.html'>c</a></span>(<span class='fl'>2</span>,
  <span class='fl'>8</span>), hyperPriorParameters = <span class='fu'><a href='https://rdrr.io/r/base/c.html'>c</a></span>(<span class='fl'>1</span>, <span class='fl'>0.125</span>), gammaPriors = <span class='fu'><a href='https://rdrr.io/r/base/c.html'>c</a></span>(<span class='fl'>2</span>, <span class='fl'>4</span>),
  alphaPriors = <span class='fu'><a href='https://rdrr.io/r/base/c.html'>c</a></span>(<span class='fl'>2</span>, <span class='fl'>4</span>), mhStepSize = <span class='fu'><a href='https://rdrr.io/r/base/c.html'>c</a></span>(<span class='fl'>0.1</span>, <span class='fl'>0.1</span>), numSticks = <span class='fl'>50</span>,

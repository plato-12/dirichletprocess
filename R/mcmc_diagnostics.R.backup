# R/mcmc_diagnostics.R

#' MCMC Diagnostics for Hierarchical Dirichlet Process
#'
#' Provides diagnostic tools to assess MCMC convergence and parameter recovery
#' for hierarchical Dirichlet process models.
#'
#' @param dp_fit A fitted hierarchical Dirichlet process object
#' @param burn_in Number of burn-in samples to discard (default: 25\\% of chain)
#' @param plot_diagnostics Whether to create diagnostic plots
#' @return A list of diagnostic statistics and plots
#' @export
diagnose_hdp_mcmc <- function(dp_fit, burn_in = NULL, plot_diagnostics = TRUE) {

  if (!inherits(dp_fit, "hierarchical")) {
    stop("This function is designed for hierarchical Dirichlet process objects")
  }

  # Set default burn-in
  if (is.null(burn_in)) {
    burn_in <- floor(length(dp_fit$gammaValues) * 0.25)
  }

  # Extract chains
  gamma_chain <- dp_fit$gammaValues
  n_iter <- length(gamma_chain)

  if (burn_in >= n_iter) {
    stop("Burn-in period cannot be >= total iterations")
  }

  post_burn_gamma <- gamma_chain[(burn_in + 1):n_iter]

  # Basic statistics
  gamma_stats <- list(
    mean = mean(post_burn_gamma),
    median = median(post_burn_gamma),
    sd = sd(post_burn_gamma),
    min = min(post_burn_gamma),
    max = max(post_burn_gamma),
    effective_sample_size = length(post_burn_gamma)
  )

  # Convergence diagnostics
  convergence <- list()

  # Simple stationarity test (compare first and second half)
  mid_point <- burn_in + floor((n_iter - burn_in) / 2)
  first_half <- gamma_chain[(burn_in + 1):mid_point]
  second_half <- gamma_chain[(mid_point + 1):n_iter]

  if (length(first_half) > 10 && length(second_half) > 10) {
    ks_test <- ks.test(first_half, second_half)
    convergence$stationarity_p_value <- ks_test$p.value
    convergence$stationarity_converged <- ks_test$p.value > 0.05
  }

  # Autocorrelation check
  if (length(post_burn_gamma) > 20) {
    acf_result <- acf(post_burn_gamma, lag.max = min(50, length(post_burn_gamma) / 4),
                      plot = FALSE)
    convergence$lag_1_autocorr <- acf_result$acf[2]
    convergence$effective_sample_size_corrected <- length(post_burn_gamma) /
      (1 + 2 * sum(acf_result$acf[-1]))
  }

  # Cluster statistics
  cluster_stats <- list()

  for (i in seq_along(dp_fit$indDP)) {
    n_clusters <- dp_fit$indDP[[i]]$numberClusters
    cluster_params <- dp_fit$indDP[[i]]$clusterParameters

    cluster_stats[[paste0("dp_", i)]] <- list(
      n_clusters = n_clusters,
      n_data_points = dp_fit$indDP[[i]]$n,
      points_per_cluster = dp_fit$indDP[[i]]$pointsPerCluster
    )

    if (!is.null(cluster_params) && length(cluster_params) >= 2) {
      mu_params <- cluster_params[[1]]
      nu_params <- cluster_params[[2]]

      cluster_stats[[paste0("dp_", i)]]$mu_range <- range(mu_params)
      cluster_stats[[paste0("dp_", i)]]$nu_range <- range(nu_params)
      cluster_stats[[paste0("dp_", i)]]$mu_mean <- mean(mu_params)
      cluster_stats[[paste0("dp_", i)]]$nu_mean <- mean(nu_params)
    }
  }

  # Global parameter statistics
  global_stats <- list()
  if (!is.null(dp_fit$globalParameters)) {
    global_mu <- dp_fit$globalParameters[[1]]
    global_nu <- dp_fit$globalParameters[[2]]

    global_stats$n_global_clusters <- length(global_mu)
    global_stats$mu_range <- range(global_mu)
    global_stats$nu_range <- range(global_nu)
    global_stats$unique_mu_rounded <- length(unique(round(global_mu, 2)))
  }

  # Create plots if requested
  plots <- list()

  if (plot_diagnostics && requireNamespace("ggplot2", quietly = TRUE)) {
    library(ggplot2)

    # Gamma trace plot
    gamma_df <- data.frame(
      iteration = 1:length(gamma_chain),
      gamma = gamma_chain,
      phase = ifelse(1:length(gamma_chain) <= burn_in, "Burn-in", "Post burn-in")
    )

    plots$gamma_trace <- ggplot(gamma_df, aes(x = iteration, y = gamma, color = phase)) +
      geom_line() +
      geom_vline(xintercept = burn_in, linetype = "dashed", alpha = 0.7) +
      labs(title = "Gamma Parameter Trace Plot",
           x = "Iteration", y = "Gamma", color = "Phase") +
      theme_minimal()

    # Gamma density plot
    plots$gamma_density <- ggplot(gamma_df[gamma_df$phase == "Post burn-in", ],
                                  aes(x = gamma)) +
      geom_density(fill = "lightblue", alpha = 0.7) +
      geom_vline(xintercept = mean(post_burn_gamma), linetype = "dashed",
                 color = "red", size = 1) +
      labs(title = "Posterior Density of Gamma",
           x = "Gamma", y = "Density") +
      theme_minimal()

    # Autocorrelation plot
    if (length(post_burn_gamma) > 20) {
      acf_data <- data.frame(
        lag = 0:(length(acf_result$acf) - 1),
        acf = as.numeric(acf_result$acf)
      )

      plots$autocorrelation <- ggplot(acf_data, aes(x = lag, y = acf)) +
        geom_hline(yintercept = 0, color = "black") +
        geom_hline(yintercept = c(-0.2, 0.2), linetype = "dashed", alpha = 0.5) +
        geom_segment(aes(xend = lag, yend = 0)) +
        labs(title = "Autocorrelation Function",
             x = "Lag", y = "Autocorrelation") +
        theme_minimal()
    }
  }

  # Compile results
  diagnostics <- list(
    gamma_statistics = gamma_stats,
    convergence_diagnostics = convergence,
    cluster_statistics = cluster_stats,
    global_statistics = global_stats,
    plots = plots,
    recommendations = generate_recommendations(gamma_stats, convergence, cluster_stats)
  )

  class(diagnostics) <- "hdp_diagnostics"
  return(diagnostics)
}

#' Generate MCMC Recommendations
#'
#' @param gamma_stats Gamma chain statistics
#' @param convergence Convergence diagnostics
#' @param cluster_stats Cluster statistics
#' @return Character vector of recommendations
generate_recommendations <- function(gamma_stats, convergence, cluster_stats) {
  recommendations <- character(0)

  # Check gamma chain
  if (!is.null(gamma_stats$sd) && gamma_stats$sd < 0.1) {
    recommendations <- c(recommendations,
                         "Gamma chain has low variability - consider checking prior specification")
  }

  if (!is.null(convergence$stationarity_converged) && !convergence$stationarity_converged) {
    recommendations <- c(recommendations,
                         "Chain may not have converged - consider longer burn-in or more iterations")
  }

  if (!is.null(convergence$lag_1_autocorr) && abs(convergence$lag_1_autocorr) > 0.5) {
    recommendations <- c(recommendations,
                         "High autocorrelation detected - consider thinning or longer chains")
  }

  # Check cluster statistics
  total_clusters <- sum(sapply(cluster_stats, function(x) x$n_clusters))
  total_data <- sum(sapply(cluster_stats, function(x) x$n_data_points))

  if (total_clusters > total_data / 3) {
    recommendations <- c(recommendations,
                         "Many small clusters detected - consider different prior parameters")
  }

  if (total_clusters == length(cluster_stats)) {
    recommendations <- c(recommendations,
                         "No clustering detected - check data and model specification")
  }

  if (length(recommendations) == 0) {
    recommendations <- "MCMC appears to be running well - no major issues detected"
  }

  return(recommendations)
}

#' Print method for HDP diagnostics
#'
#' @param x An hdp_diagnostics object
#' @param ... Additional arguments (ignored)
#' @export
print.hdp_diagnostics <- function(x, ...) {
  cat("Hierarchical Dirichlet Process MCMC Diagnostics\n")
  cat("===============================================\n\n")

  cat("Gamma Parameter Statistics:\n")
  cat(sprintf("  Mean: %.3f (SD: %.3f)\n", x$gamma_statistics$mean, x$gamma_statistics$sd))
  cat(sprintf("  Range: [%.3f, %.3f]\n", x$gamma_statistics$min, x$gamma_statistics$max))
  cat(sprintf("  Effective Sample Size: %d\n", x$gamma_statistics$effective_sample_size))

  if (!is.null(x$convergence_diagnostics$effective_sample_size_corrected)) {
    cat(sprintf("  ESS (autocorr corrected): %.1f\n",
                x$convergence_diagnostics$effective_sample_size_corrected))
  }

  cat("\nConvergence Diagnostics:\n")
  if (!is.null(x$convergence_diagnostics$stationarity_converged)) {
    cat(sprintf("  Stationarity test p-value: %.4f\n",
                x$convergence_diagnostics$stationarity_p_value))
    cat(sprintf("  Appears stationary: %s\n",
                x$convergence_diagnostics$stationarity_converged))
  }

  if (!is.null(x$convergence_diagnostics$lag_1_autocorr)) {
    cat(sprintf("  Lag-1 autocorrelation: %.3f\n",
                x$convergence_diagnostics$lag_1_autocorr))
  }

  cat("\nCluster Summary:\n")
  for (i in seq_along(x$cluster_statistics)) {
    stats <- x$cluster_statistics[[i]]
    cat(sprintf("  %s: %d clusters, %d data points\n",
                names(x$cluster_statistics)[i], stats$n_clusters, stats$n_data_points))
  }

  if (!is.null(x$global_statistics$n_global_clusters)) {
    cat(sprintf("\nGlobal Parameters: %d clusters\n", x$global_statistics$n_global_clusters))
    cat(sprintf("  Unique mu values (rounded): %d\n", x$global_statistics$unique_mu_rounded))
  }

  cat("\nRecommendations:\n")
  for (rec in x$recommendations) {
    cat(sprintf("  - %s\n", rec))
  }

  if (length(x$plots) > 0) {
    cat(sprintf("\nDiagnostic plots available: %s\n", paste(names(x$plots), collapse = ", ")))
  }
}

#' Quick MCMC check for test environments
#'
#' @param dp_fit Fitted DP object
#' @return Logical indicating if basic checks pass
#' @export
quick_mcmc_check <- function(dp_fit) {
  if (!inherits(dp_fit, "hierarchical")) return(FALSE)

  # Basic validity checks
  if (is.null(dp_fit$gammaValues) || length(dp_fit$gammaValues) == 0) return(FALSE)
  if (any(!is.finite(dp_fit$gammaValues))) return(FALSE)
  if (any(dp_fit$gammaValues <= 0)) return(FALSE)

  # Check that we have reasonable cluster assignments
  for (i in seq_along(dp_fit$indDP)) {
    if (dp_fit$indDP[[i]]$numberClusters <= 0) return(FALSE)
    if (sum(dp_fit$indDP[[i]]$pointsPerCluster) != dp_fit$indDP[[i]]$n) return(FALSE)
  }

  return(TRUE)
}
